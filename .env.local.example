# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key (server-only, never share) — used for background Gmail/Calendar sync
SUPABASE_SECRET_KEY=sb_secret_...

# Anthropic API key (console.anthropic.com → API Keys) — powers memories, Ask and meeting prep
ANTHROPIC_API_KEY=

# Google Cloud → Google Auth Platform → Clients (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any long random string; Vercel Cron sends it to /api/cron/sync
CRON_SECRET=

# 32 random bytes, base64 (openssl rand -base64 32) — encrypts stored Google tokens
TOKEN_ENCRYPTION_KEY=
# Comma-separated accounts allowed to connect Gmail (Google "restricted" scope; ≤100 test users until CASA)
GMAIL_BETA_EMAILS=
# "true" once the Google provider is enabled in Supabase → Authentication → Sign In / Providers
NEXT_PUBLIC_GOOGLE_SIGNIN=false
# Shown on the Privacy Policy and Terms pages
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional daily AI caps per user
# DAILY_MEMORY_LIMIT=200
# DAILY_ASK_LIMIT=25
# DAILY_PREP_LIMIT=15

# Stripe → Developers → API keys (use sk_test_… until launch). Then run: npm run stripe:setup
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → endpoint …/api/stripe/webhook (or `stripe listen` locally)
STRIPE_WEBHOOK_SECRET=
